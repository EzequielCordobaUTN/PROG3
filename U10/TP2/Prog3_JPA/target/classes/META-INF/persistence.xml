<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.mycompany.prog3_jpa.entity.Usuario</class>
        <class>com.mycompany.prog3_jpa.entity.PuntoVenta</class>
        <class>com.mycompany.prog3_jpa.entity.TipoMoneda</class>
        <class>com.mycompany.prog3_jpa.entity.FacturaVenta</class>
        <class>com.mycompany.prog3_jpa.entity.FacturaVentaDetalle</class>
        <class>com.mycompany.prog3_jpa.entity.Cliente</class>
        <class>com.mycompany.prog3_jpa.entity.CondicionIva</class>
        <class>com.mycompany.prog3_jpa.entity.Contacto</class>
        <class>com.mycompany.prog3_jpa.entity.Domicilio</class>
        <class>com.mycompany.prog3_jpa.entity.ListaPrecioArticulo</class>
        <class>com.mycompany.prog3_jpa.entity.Articulo</class>
        <class>com.mycompany.prog3_jpa.entity.ListaPrecio</class>
        <class>com.mycompany.prog3_jpa.entity.Marca</class>
        <class>com.mycompany.prog3_jpa.entity.Rubro</class>
        <properties>
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/tp1"/>
            <property name="javax.persistence.jdbc.user" value="postgres"/>
            <property name="javax.persistence.jdbc.password" value="004117"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>
</persistence>